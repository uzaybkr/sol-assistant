# Powers the "Sol" AI assistant. Without it the chat falls back to built-in answers.
ANTHROPIC_API_KEY=

# Contact form delivery via Resend (https://resend.com). Without these the form
# tells visitors to email support@example.com directly instead.
RESEND_API_KEY=
CONTACT_TO=support@example.com
CONTACT_FROM=Acme Cyber Website <web@example.com>
