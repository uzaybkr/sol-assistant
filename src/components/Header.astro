---
import { NAV, EMAIL } from '../data/site.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = n => { const base = n.match || n.href; return path === base || path.startsWith(base + '/'); };
---
<header class="hdr">
  <div class="strip"><div class="wrap"><span class="pulse"></span>US-based Security Operations Center<span class="hide-sm">&nbsp;· Monitoring 24/7/365 · {EMAIL}</span></div></div>
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Acme Cyber home">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <path d="M20 3l14 5v10c0 9-6 16-14 19C12 34 6 27 6 18V8z" fill="url(#gg)"/>
        <circle cx="20" cy="19" r="6" fill="#08131f"/>
        <path d="M20 9v3M20 26v3M10 19h3M27 19h3M13 12l2 2M25 24l2 2M27 12l-2 2M15 24l-2 2" stroke="#08131f" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>ACME <small>CYBER</small></span>
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      {NAV.map(n => <a href={n.href} aria-current={current(n) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn btn-solar" href="/plan">Build your plan</a>
    <button class="menu" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
