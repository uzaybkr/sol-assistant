---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="nf grain">
    <div class="wrap" style="display:grid;gap:22px;justify-items:center">
      <h1>404</h1>
      <h2>This page is <span class="sun-text">outside the perimeter.</span></h2>
      <p class="lede">The link may be old or mistyped. Everything we protect is one click away.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
        <a class="btn btn-solar" href="/">Back to home <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</Base>
